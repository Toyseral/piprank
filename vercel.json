{
  "redirects": [
    {
      "source": "/vietnam/:locale/:topic",
      "destination": "/countries/vietnam/:locale/:topic",
      "statusCode": 301
    },
    {
      "source": "/vietnam/guides/:slug",
      "destination": "/countries/vietnam/:slug",
      "statusCode": 301
    },
    {
      "source": "/vietnam/:topic",
      "destination": "/countries/vietnam/:topic",
      "statusCode": 301
    },
    {
      "source": "/vietnam",
      "destination": "/countries/vietnam",
      "statusCode": 301
    },
    {
      "source": "/countries/:countrySlug/best/:intent",
      "destination": "/countries/:countrySlug/:intent",
      "statusCode": 301
    },
    {
      "source": "/compare/:pair/",
      "destination": "/compare/:pair",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/compare/:pair",
      "destination": "/api/compare-pair?pair=:pair"
    },
    {
      "source": "/go/:broker",
      "destination": "/api/go?broker=:broker"
    },
    {
      "source": "/api/admin-users",
      "destination": "/api/site?resource=admin-users"
    },
    {
      "source": "/api/logo-upload",
      "destination": "/api/site?resource=logo-upload"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/site?resource=newsletter"
    },
    {
      "source": "/api/promotions",
      "destination": "/api/site?resource=promotions"
    },
    {
      "source": "/api/track",
      "destination": "/api/analytics"
    },
    {
      "source": "/api/affiliate-links",
      "destination": "/api/analytics"
    },
    {
      "source": "/api/guides",
      "destination": "/api/content?resource=guides"
    },
    {
      "source": "/api/intents",
      "destination": "/api/content?resource=intents"
    },
    {
      "source": "/api/countries",
      "destination": "/api/content?resource=countries"
    },
    {
      "source": "/api/country-best-for",
      "destination": "/api/content?resource=country-best-for"
    },
    {
      "source": "/api/country-languages",
      "destination": "/api/content?resource=country-languages"
    },
    {
      "source": "/api/localized-seo-pages",
      "destination": "/api/content?resource=localized-seo-pages"
    },
    {
      "source": "/api/content-documents",
      "destination": "/api/content?resource=content-documents"
    },
    {
      "source": "/api/content-assets",
      "destination": "/api/content?resource=content-assets"
    },
    {
      "source": "/api/seo-page-generator",
      "destination": "/api/content?resource=seo-page-generator"
    },
    {
      "source": "/api/localization-ui-packs",
      "destination": "/api/content?resource=localization-ui-packs"
    },
    {
      "source": "/api/localization-glossary",
      "destination": "/api/content?resource=localization-glossary"
    },
    {
      "source": "/api/localization-health",
      "destination": "/api/content?resource=localization-health"
    },
    {
      "source": "/api/country-intent-rankings",
      "destination": "/api/content?resource=country-intent-rankings"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/compare-pair.js": {
      "includeFiles": "dist/compare/**"
    }
  },
  "headers": [
    {
      "source": "/:country/:locale/:topic",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/:country",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
