# Required environment variables (get values from your Supabase project dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional until the final production domain is chosen. Example: https://piprank.com
VITE_SITE_URL=

# Optional: Vercel deploy hook fired when a localized page is published (CDN refresh via rebuild)
VERCEL_DEPLOY_HOOK_URL=
